{
  "name": "tinting-jd-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Tinting-JD desktop app (local backend + frontend, MongoDB Atlas)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:app": "node scripts/build-app.mjs",
    "dist": "node scripts/build-app.mjs && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tintingjd.desktop",
    "productName": "Tinting-JD",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "loading.html",
      "loading.js",
      "reconnect.html",
      "reconnect.js"
    ],
    "extraResources": [
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/frontend",
        "to": "frontend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tinting-JD"
    }
  }
}
